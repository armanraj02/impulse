# ==============================================================================
# InPulse Academic Intelligence Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values for your environment.
# Note: NEVER commit your actual '.env' file containing real secrets to Git.

# ------------------------------------------------------------------------------
# 1. Airflow Orchestration Settings
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=46BKJoPlCeffqqHGqmAA1wOFAnKcAnEBhsfa0eTeAtE=

# ------------------------------------------------------------------------------
# 2. PostgreSQL Operational Database (inpulse_db)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=inpulse_db

# ------------------------------------------------------------------------------
# 3. Analytics Database & Read-Only User (academic_analytics_db)
# ------------------------------------------------------------------------------
ANALYTICS_DB_HOST=postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=academic_analytics_db
ANALYTICS_DB_USER=analytics_readonly
ANALYTICS_DB_PASSWORD=readonly123

# ------------------------------------------------------------------------------
# 4. SMTP Email Delivery Configuration (for HOD Weekly Reports)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=reports@inpulse.edu
SMTP_TO=hod@inpulse.edu
SMTP_USE_TLS=true

# Set to 'false' only when ready for live email dispatch to HODs
SMTP_DRY_RUN=true

# ------------------------------------------------------------------------------
# 5. Frontend & Backend Networking
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
