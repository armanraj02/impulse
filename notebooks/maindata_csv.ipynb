   "source": [
    "# ============================================================\n",
    "# 9. ENROLLMENTS\n",
    "# SEMESTER-CONSISTENT + 100% STUDENT COVERAGE\n",
    "# ============================================================\n",
    "\n",
    "enrollments = []\n",
    "\n",
    "enrollment_id = 1\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Create section lookup\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "section_lookup = {}\n",
    "\n",
    "for _, section in sections_df.iterrows():\n",
    "\n",
    "    key = (\n",
    "        section[\"course_id\"],\n",
    "        section[\"branch_id\"],\n",
    "        section[\"batch_id\"]\n",
    "    )\n",
    "\n",
    "    section_lookup.setdefault(\n",
    "        key,\n",
    "        []\n",
    "    ).append(\n",
    "        section[\"section_id\"]\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Generate enrollments\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "for _, student in students_df.iterrows():\n",
    "\n",
    "    student_id = student[\"student_id\"]\n",
    "\n",
    "    branch_id = student[\"branch_id\"]\n",
    "\n",
    "    batch_id = student[\"batch_id\"]\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Get student's batch semester\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    student_semester = batches_df.loc[\n",
    "        batches_df[\"batch_id\"] == batch_id,\n",
    "        \"semester\"\n",
    "    ].iloc[0]\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # ONLY courses belonging to student's semester\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    valid_courses = courses_df[\n",
    "        courses_df[\"semester\"]\n",
    "        ==\n",
    "        student_semester\n",
    "    ]\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Find courses that actually have a section\n",
    "    # for this student's branch + batch\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    available_courses = []\n",
    "\n",
    "    for course_id in valid_courses[\n",
    "        \"course_id\"\n",
    "    ]:\n",
    "\n",
    "        key = (\n",
    "            course_id,\n",
    "            branch_id,\n",
    "            batch_id\n",
    "        )\n",
    "\n",
    "        if key in section_lookup:\n",
    "\n",
    "            available_courses.append(\n",
    "                course_id\n",
    "            )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # SAFETY CHECK\n",
    "    # Every student MUST have at least one course\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if not available_courses:\n",
    "\n",
    "        raise ValueError(\n",
    "            f\"No valid course found for \"\n",
    "            f\"student_id={student_id}, \"\n",
    "            f\"branch_id={branch_id}, \"\n",
    "            f\"batch_id={batch_id}, \"\n",
    "            f\"semester={student_semester}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Select courses\n",
    "    #\n",
    "    # Since semester consistency is mandatory,\n",
    "    # select only from available courses.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    number_of_courses = random.randint(\n",
    "        1,\n",
    "        min(\n",
    "            2,\n",
    "            len(available_courses)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    selected_courses = random.sample(\n",
    "        available_courses,\n",
    "        number_of_courses\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Create enrollment\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    for course_id in selected_courses:\n",
    "\n",
    "        key = (\n",
    "            course_id,\n",
    "            branch_id,\n",
    "            batch_id\n",
    "        )\n",
    "\n",
    "        section_id = random.choice(\n",
    "            section_lookup[key]\n",
    "        )\n",
    "\n",
    "        enrollment_date = (\n",
    "            ACADEMIC_START\n",
    "            +\n",
    "            pd.Timedelta(\n",
    "                days=random.randint(\n",
    "                    0,\n",
    "                    14\n",
    "                )\n",
    "            )\n",
    "        )\n",
    "\n",
    "        status = random.choices(\n",
    "            [\"Active\", \"Completed\"],\n",
    "            weights=[80, 20],\n",
    "            k=1\n",
    "        )[0]\n",
    "\n",
    "        enrollments.append([\n",
    "            enrollment_id,\n",
    "            student_id,\n",
    "            course_id,\n",
    "            section_id,\n",
    "            enrollment_date.strftime(\n",
    "                \"%Y-%m-%d\"\n",
    "            ),\n",
    "            status\n",
    "        ])\n",
    "\n",
    "        enrollment_id += 1\n",
    "\n",
    "\n",
    "enrollments_df = pd.DataFrame(\n",
    "    enrollments,\n",
    "    columns=[\n",
    "        \"enrollment_id\",\n",
    "        \"student_id\",\n",
    "        \"course_id\",\n",
    "        \"section_id\",\n",
    "        \"enrollment_date\",\n",
    "        \"status\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Total enrollments:\",\n",
    "    len(enrollments_df)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Unique enrolled students:\",\n",
    "    enrollments_df[\n",
    "        \"student_id\"\n",
    "    ].nunique()\n",
    ")\n",
    "\n",
    "display(\n",
    "    enrollments_df.head(10)\n",
    ")"
   ]
  },
