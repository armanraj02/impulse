    "# ============================================================\n",
    "# 12. ASSESSMENTS\n",
    "# ============================================================\n",
    "\n",
    "assessment_pattern = [\n",
    "    (\"Quiz 1\", \"Quiz\", 5),\n",
    "    (\"Quiz 2\", \"Quiz\", 5),\n",
    "    (\"Assignment\", \"Assignment\", 10),\n",
    "    (\"CIE\", \"CIE\", 25),\n",
    "    (\"Assessment\", \"Assessment\", 50)\n",
    "]\n",
    "\n",
    "assessments = []\n",
    "\n",
    "assessment_id = 1\n",
    "\n",
    "\n",
    "for _, module in modules_df.iterrows():\n",
    "\n",
    "    start_date = pd.to_datetime(\n",
    "        module[\"start_date\"]\n",
    "    )\n",
    "\n",
    "    end_date = pd.to_datetime(\n",
    "        module[\"end_date\"]\n",
    "    )\n",
    "\n",
    "    assessment_dates = pd.date_range(\n",
    "        start=start_date,\n",
    "        end=end_date,\n",
    "        periods=5\n",
    "    )\n",
    "\n",
    "    for i, (\n",
    "        assessment_name,\n",
    "        assessment_type,\n",
    "        max_marks\n",
    "    ) in enumerate(\n",
    "        assessment_pattern\n",
    "    ):\n",
    "\n",
    "        assessments.append([\n",
    "            assessment_id,\n",
    "            module[\"course_id\"],\n",
    "            module[\"module_id\"],\n",
    "            assessment_name,\n",
    "            assessment_type,\n",
    "            max_marks,\n",
    "            assessment_dates[i].strftime(\n",
    "                \"%Y-%m-%d\"\n",
    "            )\n",
    "        ])\n",
    "\n",
    "        assessment_id += 1\n",
    "\n",
    "\n",
    "assessments_df = pd.DataFrame(\n",
    "    assessments,\n",
    "    columns=[\n",
    "        \"assessment_id\",\n",
    "        \"course_id\",\n",
    "        \"module_id\",\n",
    "        \"assessment_name\",\n",
    "        \"assessment_type\",\n",
    "        \"max_marks\",\n",
    "        \"assessment_date\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Total assessments:\",\n",
    "    len(assessments_df)\n",
    ")\n",
    "\n",
    "display(\n",
    "    assessments_df.head(10)\n",
    ")"
   ]
  },
