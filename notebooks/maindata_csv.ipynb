   ],
   "source": [
    "# ============================================================\n",
    "# 4. STUDENTS\n",
    "# ============================================================\n",
    "\n",
    "NUM_STUDENTS = 5000\n",
    "\n",
    "students = []\n",
    "\n",
    "branch_usn_codes = {\n",
    "    1: \"CS\",\n",
    "    2: \"AI\",\n",
    "    3: \"IS\",\n",
    "    4: \"EC\",\n",
    "    5: \"ME\"\n",
    "}\n",
    "\n",
    "# Realistic distribution across batches\n",
    "batch_weights = {\n",
    "    1: 0.12,\n",
    "    2: 0.15,\n",
    "    3: 0.18,\n",
    "    4: 0.20,\n",
    "    5: 0.20,\n",
    "    6: 0.15\n",
    "}\n",
    "\n",
    "batch_ids = list(batch_weights.keys())\n",
    "batch_probs = list(batch_weights.values())\n",
    "\n",
    "# DOB ranges\n",
    "batch_birth_years = {\n",
    "    1: (2002, 2004),\n",
    "    2: (2003, 2005),\n",
    "    3: (2004, 2006),\n",
    "    4: (2005, 2007),\n",
    "    5: (2006, 2008),\n",
    "    6: (2007, 2009)\n",
    "}\n",
    "\n",
    "for student_id in range(1, NUM_STUDENTS + 1):\n",
    "\n",
    "    # Branch\n",
    "    branch_id = random.choices(\n",
    "        [1, 2, 3, 4, 5],\n",
    "        weights=[30, 25, 20, 15, 10],\n",
    "        k=1\n",
    "    )[0]\n",
    "\n",
    "    # Batch\n",
    "    batch_id = random.choices(\n",
    "        batch_ids,\n",
    "        weights=batch_probs,\n",
    "        k=1\n",
    "    )[0]\n",
    "\n",
    "    student_name = fake.name()\n",
    "\n",
    "    clean_name = (\n",
    "        student_name\n",
    "        .lower()\n",
    "        .replace(\" \", \".\")\n",
    "        .replace(\"'\", \"\")\n",
    "    )\n",
    "\n",
    "    email = (\n",
    "        f\"{clean_name}.{student_id}\"\n",
    "        f\"@sahyadri.edu.in\"\n",
    "    )\n",
    "\n",
    "    # DOB\n",
    "    min_year, max_year = batch_birth_years[batch_id]\n",
    "\n",
    "    birth_year = random.randint(\n",
    "        min_year,\n",
    "        max_year\n",
    "    )\n",
    "\n",
    "    dob = date(\n",
    "        birth_year,\n",
    "        random.randint(1, 12),\n",
    "        random.randint(1, 28)\n",
    "    )\n",
    "\n",
    "    # Batch starting year\n",
    "    batch_start_year = int(\n",
    "        batches_df.loc[\n",
    "            batches_df[\"batch_id\"] == batch_id,\n",
    "            \"batch_name\"\n",
    "        ].iloc[0][:4]\n",
    "    )\n",
    "\n",
    "    # USN\n",
    "    usn = (\n",
    "        f\"4SF\"\n",
    "        f\"{str(batch_start_year)[-2:]}\"\n",
    "        f\"{branch_usn_codes[branch_id]}\"\n",
    "        f\"{student_id:04d}\"\n",
    "    )\n",
    "\n",
    "    gender = random.choices(\n",
    "        [\"Male\", \"Female\"],\n",
    "        weights=[55, 45],\n",
    "        k=1\n",
    "    )[0]\n",
    "\n",
    "    students.append([\n",
    "        student_id,\n",
    "        usn,\n",
    "        student_name,\n",
    "        email,\n",
    "        branch_id,\n",
    "        batch_id,\n",
    "        gender,\n",
    "        dob\n",
    "    ])\n",
    "\n",
    "\n",
    "students_df = pd.DataFrame(\n",
    "    students,\n",
    "    columns=[\n",
    "        \"student_id\",\n",
    "        \"usn\",\n",
    "        \"student_name\",\n",
    "        \"email\",\n",
    "        \"branch_id\",\n",
    "        \"batch_id\",\n",
    "        \"gender\",\n",
    "        \"date_of_birth\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"Students:\", len(students_df))\n",
    "\n",
    "display(students_df.head(10))"
   ]
  },
