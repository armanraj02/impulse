   "source": [
    "# ============================================================\n",
    "# 11. MODULES\n",
    "# ============================================================\n",
    "\n",
    "module_names = {\n",
    "\n",
    "    1: [\n",
    "        \"Robotics Fundamentals\",\n",
    "        \"Robot Kinematics\",\n",
    "        \"Sensors and Actuators\",\n",
    "        \"Robot Control\",\n",
    "        \"Robotics Applications\"\n",
    "    ],\n",
    "\n",
    "    2: [\n",
    "        \"HTML and CSS\",\n",
    "        \"JavaScript\",\n",
    "        \"Frontend Development\",\n",
    "        \"Backend Development\",\n",
    "        \"Full Stack Integration\"\n",
    "    ],\n",
    "\n",
    "    3: [\n",
    "        \"Data Engineering Fundamentals\",\n",
    "        \"ETL and ELT Pipelines\",\n",
    "        \"Data Warehousing\",\n",
    "        \"Data Lakes\",\n",
    "        \"Pipeline Orchestration\"\n",
    "    ],\n",
    "\n",
    "    4: [\n",
    "        \"AI Fundamentals\",\n",
    "        \"Machine Learning\",\n",
    "        \"Deep Learning\",\n",
    "        \"Natural Language Processing\",\n",
    "        \"AI Applications\"\n",
    "    ],\n",
    "\n",
    "    5: [\n",
    "        \"Embedded Systems Fundamentals\",\n",
    "        \"Microcontrollers\",\n",
    "        \"Embedded Programming\",\n",
    "        \"Embedded Communication\",\n",
    "        \"Embedded Applications\"\n",
    "    ],\n",
    "\n",
    "    6: [\n",
    "        \"IoT Fundamentals\",\n",
    "        \"IoT Architecture\",\n",
    "        \"Sensors and Connectivity\",\n",
    "        \"IoT Communication\",\n",
    "        \"IoT Applications\"\n",
    "    ]\n",
    "}\n",
    "\n",
    "\n",
    "modules = []\n",
    "\n",
    "module_id = 1\n",
    "\n",
    "total_days = (\n",
    "    ACADEMIC_END\n",
    "    -\n",
    "    ACADEMIC_START\n",
    ").days + 1\n",
    "\n",
    "module_duration = total_days // 5\n",
    "\n",
    "\n",
    "for course_id in courses_df[\n",
    "    \"course_id\"\n",
    "]:\n",
    "\n",
    "    for module_order in range(1, 6):\n",
    "\n",
    "        module_name = module_names[\n",
    "            course_id\n",
    "        ][module_order - 1]\n",
    "\n",
    "        start_date = (\n",
    "            ACADEMIC_START\n",
    "            +\n",
    "            pd.Timedelta(\n",
    "                days=(\n",
    "                    module_order - 1\n",
    "                )\n",
    "                *\n",
    "                module_duration\n",
    "            )\n",
    "        )\n",
    "\n",
    "        if module_order < 5:\n",
    "\n",
    "            end_date = (\n",
    "                start_date\n",
    "                +\n",
    "                pd.Timedelta(\n",
    "                    days=module_duration - 1\n",
    "                )\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            end_date = ACADEMIC_END\n",
    "\n",
    "        modules.append([\n",
    "            module_id,\n",
    "            course_id,\n",
    "            module_name,\n",
    "            module_order,\n",
    "            start_date.strftime(\n",
    "                \"%Y-%m-%d\"\n",
    "            ),\n",
    "            end_date.strftime(\n",
    "                \"%Y-%m-%d\"\n",
    "            )\n",
    "        ])\n",
    "\n",
    "        module_id += 1\n",
    "\n",
    "\n",
    "modules_df = pd.DataFrame(\n",
    "    modules,\n",
    "    columns=[\n",
    "        \"module_id\",\n",
    "        \"course_id\",\n",
    "        \"module_name\",\n",
    "        \"module_order\",\n",
    "        \"start_date\",\n",
    "        \"end_date\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Total modules:\",\n",
    "    len(modules_df)\n",
    ")\n",
    "\n",
    "display(modules_df.head(10))"
   ]
