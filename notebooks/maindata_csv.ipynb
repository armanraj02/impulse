    "# ============================================================\n",
    "# 13. ASSESSMENT SCORES\n",
    "# ============================================================\n",
    "\n",
    "assessment_scores = []\n",
    "\n",
    "score_id = 1\n",
    "\n",
    "\n",
    "student_profiles = {}\n",
    "\n",
    "for student_id in students_df[\n",
    "    \"student_id\"\n",
    "]:\n",
    "\n",
    "    student_profiles[\n",
    "        student_id\n",
    "    ] = random.choices(\n",
    "        [\"High\", \"Medium\", \"Low\"],\n",
    "        weights=[25, 55, 20],\n",
    "        k=1\n",
    "    )[0]\n",
    "\n",
    "\n",
    "# Only assessments belonging to student's enrolled courses\n",
    "for _, enrollment in enrollments_df.iterrows():\n",
    "\n",
    "    student_id = enrollment[\"student_id\"]\n",
    "    course_id = enrollment[\"course_id\"]\n",
    "\n",
    "    course_assessments = assessments_df[\n",
    "        assessments_df[\"course_id\"]\n",
    "        ==\n",
    "        course_id\n",
    "    ]\n",
    "\n",
    "    profile = student_profiles[\n",
    "        student_id\n",
    "    ]\n",
    "\n",
    "    for _, assessment in (\n",
    "        course_assessments.iterrows()\n",
    "    ):\n",
    "\n",
    "        max_marks = assessment[\n",
    "            \"max_marks\"\n",
    "        ]\n",
    "\n",
    "        submitted = (\n",
    "            random.random() > 0.05\n",
    "        )\n",
    "\n",
    "        # NOT SUBMITTED\n",
    "        if not submitted:\n",
    "\n",
    "            marks_obtained = None\n",
    "            graded = False\n",
    "\n",
    "        else:\n",
    "\n",
    "            graded = (\n",
    "                random.random() > 0.10\n",
    "            )\n",
    "\n",
    "            # SUBMITTED BUT NOT GRADED\n",
    "            if not graded:\n",
    "\n",
    "                marks_obtained = None\n",
    "\n",
    "            else:\n",
    "\n",
    "                if profile == \"High\":\n",
    "\n",
    "                    percentage = random.uniform(\n",
    "                        0.75,\n",
    "                        0.98\n",
    "                    )\n",
    "\n",
    "                elif profile == \"Medium\":\n",
    "\n",
    "                    percentage = random.uniform(\n",
    "                        0.55,\n",
    "                        0.80\n",
    "                    )\n",
    "\n",
    "                else:\n",
    "\n",
    "                    percentage = random.uniform(\n",
    "                        0.30,\n",
    "                        0.60\n",
    "                    )\n",
    "\n",
    "                marks_obtained = round(\n",
    "                    max_marks * percentage,\n",
    "                    2\n",
    "                )\n",
    "\n",
    "        assessment_scores.append([\n",
    "            score_id,\n",
    "            assessment[\"assessment_id\"],\n",
    "            student_id,\n",
    "            marks_obtained,\n",
    "            submitted,\n",
    "            graded\n",
    "        ])\n",
    "\n",
    "        score_id += 1\n",
    "\n",
    "\n",
    "assessment_scores_df = pd.DataFrame(\n",
    "    assessment_scores,\n",
    "    columns=[\n",
    "        \"score_id\",\n",
    "        \"assessment_id\",\n",
    "        \"student_id\",\n",
    "        \"marks_obtained\",\n",
    "        \"submitted\",\n",
    "        \"graded\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "display(\n",
    "    assessment_scores_df.head(10)\n",
    ")"
   ]
