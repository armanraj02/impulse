    "# ============================================================\n",
    "# 14. ATTENDANCE\n",
    "# ============================================================\n",
    "\n",
    "attendance = []\n",
    "\n",
    "attendance_id = 1\n",
    "\n",
    "\n",
    "for _, enrollment in enrollments_df.iterrows():\n",
    "\n",
    "    student_id = enrollment[\"student_id\"]\n",
    "    course_id = enrollment[\"course_id\"]\n",
    "    section_id = enrollment[\"section_id\"]\n",
    "\n",
    "    course_modules = modules_df[\n",
    "        modules_df[\"course_id\"]\n",
    "        ==\n",
    "        course_id\n",
    "    ]\n",
    "\n",
    "    start_date = pd.to_datetime(\n",
    "        course_modules[\"start_date\"].min()\n",
    "    )\n",
    "\n",
    "    end_date = pd.to_datetime(\n",
    "        course_modules[\"end_date\"].max()\n",
    "    )\n",
    "\n",
    "    class_dates = pd.date_range(\n",
    "        start=start_date,\n",
    "        end=end_date,\n",
    "        freq=\"2D\"\n",
    "    )\n",
    "\n",
    "    profile = student_profiles[\n",
    "        student_id\n",
    "    ]\n",
    "\n",
    "    for attendance_date in class_dates:\n",
    "\n",
    "        if profile == \"High\":\n",
    "\n",
    "            status = random.choices(\n",
    "                [\"Present\", \"Absent\"],\n",
    "                weights=[95, 5],\n",
    "                k=1\n",
    "            )[0]\n",
    "\n",
    "        elif profile == \"Medium\":\n",
    "\n",
    "            status = random.choices(\n",
    "                [\"Present\", \"Absent\"],\n",
    "                weights=[85, 15],\n",
    "                k=1\n",
    "            )[0]\n",
    "\n",
    "        else:\n",
    "\n",
    "            status = random.choices(\n",
    "                [\"Present\", \"Absent\"],\n",
    "                weights=[65, 35],\n",
    "                k=1\n",
    "            )[0]\n",
    "\n",
    "        attendance.append([\n",
    "            attendance_id,\n",
    "            student_id,\n",
    "            course_id,\n",
    "            section_id,\n",
    "            attendance_date.strftime(\n",
    "                \"%Y-%m-%d\"\n",
    "            ),\n",
    "            status\n",
    "        ])\n",
    "\n",
    "        attendance_id += 1\n",
    "\n",
    "\n",
    "attendance_df = pd.DataFrame(\n",
    "    attendance,\n",
    "    columns=[\n",
    "        \"attendance_id\",\n",
    "        \"student_id\",\n",
    "        \"course_id\",\n",
    "        \"section_id\",\n",
    "        \"attendance_date\",\n",
    "        \"status\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "display(\n",
    "    attendance_df.head(10)\n",
    ")"
   ]
