    "    .merge(\n",
    "        batches_df[\n",
    "            [\n",
    "                \"batch_id\",\n",
    "                \"semester\"\n",
    "            ]\n",
    "        ],\n",
    "        on=\"batch_id\",\n",
    "        how=\"left\",\n",
    "        suffixes=(\n",
