    "# ============================================================\n",
    "# 15. FEEDBACK FORMS\n",
    "# ============================================================\n",
    "\n",
    "feedback_forms = []\n",
    "\n",
    "feedback_form_id = 1\n",
    "\n",
    "\n",
    "for _, module in modules_df.iterrows():\n",
    "\n",
    "    course_id = module[\"course_id\"]\n",
    "    module_id = module[\"module_id\"]\n",
    "\n",
    "    course_sections = sections_df[\n",
    "        sections_df[\"course_id\"]\n",
    "        ==\n",
    "        course_id\n",
    "    ]\n",
    "\n",
    "    for _, section in course_sections.iterrows():\n",
    "\n",
    "        section_id = section[\n",
    "            \"section_id\"\n",
    "        ]\n",
    "\n",
    "        # Find assigned instructor\n",
    "        assigned = (\n",
    "            course_instructors_df[\n",
    "                course_instructors_df[\n",
    "                    \"section_id\"\n",
    "                ]\n",
    "                ==\n",
    "                section_id\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        if assigned.empty:\n",
    "            continue\n",
    "\n",
    "        instructor_id = assigned.iloc[0][\n",
    "            \"instructor_id\"\n",
    "        ]\n",
    "\n",
    "        feedback_forms.append([\n",
    "            feedback_form_id,\n",
    "            course_id,\n",
    "            module_id,\n",
    "            section_id,\n",
    "            instructor_id,\n",
    "            module[\"end_date\"],\n",
    "            \"Module Feedback\"\n",
    "        ])\n",
    "\n",
    "        feedback_form_id += 1\n",
    "\n",
    "\n",
    "feedback_forms_df = pd.DataFrame(\n",
    "    feedback_forms,\n",
    "    columns=[\n",
    "        \"feedback_form_id\",\n",
    "        \"course_id\",\n",
    "        \"module_id\",\n",
    "        \"section_id\",\n",
    "        \"instructor_id\",\n",
    "        \"feedback_date\",\n",
    "        \"feedback_type\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Feedback forms:\",\n",
    "    len(feedback_forms_df)\n",
    ")\n",
    "\n",
    "display(\n",
    "    feedback_forms_df.head(10)\n",
    ")"
   ]
  },
