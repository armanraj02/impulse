    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "assessments_df[\"assessment_date\"] = pd.to_datetime(\n",
    "    assessments_df[\"assessment_date\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "attendance_df[\"attendance_date\"] = pd.to_datetime(\n",
    "    attendance_df[\"attendance_date\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "feedback_forms_df[\"feedback_date\"] = pd.to_datetime(\n",
