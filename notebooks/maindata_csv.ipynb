    "                \"semester\"\n",
    "            ]\n",
    "        ],\n",
    "        on=\"course_id\",\n",
    "        how=\"left\",\n",
    "        suffixes=(\n",
    "            \"_batch\",\n",
    "            \"_course\"\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "enrollment_invalid = (\n",
    "    enrollment_check[\n",
    "        \"semester_batch\"\n",
    "    ]\n",
    "    !=\n",
    "    enrollment_check[\n",
    "        \"semester_course\"\n",
    "    ]\n",
